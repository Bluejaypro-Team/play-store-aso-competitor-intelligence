# ==============================================================================
# Google Play Store ASO & Competitor Intelligence Studio - Environment Config
# Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini & Search Grounding API
# Required for autonomous keyword research, semantic clustering & live web grounding.
# Obtain key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) & Vertex AI Enterprise Config
# Required when running inside Antigravity IDE with active GCP paid account / ADC.
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=

# Quota Attribution Header (e.g. tidal-mode-490503-i9)
X_GOOG_USER_PROJECT=

# ------------------------------------------------------------------------------
# 3. Google Cloud Natural Language API
# Used to analyze competitor review sentiment and audit Entity Salience scores.
# ------------------------------------------------------------------------------
CLOUD_NATURAL_LANGUAGE_API_KEY=

# ------------------------------------------------------------------------------
# 4. Google Play Developer Publishing API
# Optional: Used for automated Play Console metadata deployment & Listing Experiments.
# Service account JSON must have 'Release manager' or 'Admin' permissions.
# ------------------------------------------------------------------------------
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=

# ------------------------------------------------------------------------------
# 5. BigQuery & Google Search Console (GSC) Lakehouse
# Optional: Used for cross-referencing web search console queries against app rankings.
# ------------------------------------------------------------------------------
BIGQUERY_DATASET_ID=
SEARCH_CONSOLE_PROPERTY_URL=

# ------------------------------------------------------------------------------
# 6. Antigravity IDE Runtime Settings
# ------------------------------------------------------------------------------
ANTIGRAVITY_ENV=production
OUTPUT_DOWNLOADS_FOLDER=
